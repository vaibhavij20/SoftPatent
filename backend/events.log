{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/gaming_ai_battle_simulator.py", "text": "import math\nimport random\nimport time\nimport logging\nfrom typing import List, Tuple\n\nlogging.basicConfig(level=logging.INFO)\n\n\n# -------------------------------------------------\n#   VECTOR MATH (inefficient on purpose)\n# -------------------------------------------------\ndef vec_length(v: Tuple[float, float]) -> float:\n    # Repeated sqrt \u2014 slow!\n    return math.sqrt(v[0] * v[0] + v[1] * v[1])\n\n\ndef vec_normalize(v: Tuple[float, float]) -> Tuple[float, float]:\n    l = vec_length(v)\n    if l == 0:\n        return (0.0, 0.0)\n    return (v[0] / l, v[1] / l)\n\n\n# -------------------------------------------------\n#  ENTITY CLASS\n# -------------------------------------------------\nclass Entity:\n    def __init__(self, name: str, x: float, y: float):\n        self.name = name\n        self.x = x\n        self.y = y\n        self.hp = 100\n        self.speed = random.uniform(0.8, 1.2)\n\n    def pos(self):\n        return (self.x, self.y)\n\n\n# -------------------------------------------------\n#  AI STEERING (flocking-like)\n# -------------------------------------------------\ndef compute_steering(entity: Entity, target: Tuple[float, float]) -> Tuple[float, float]:\n    dx = target[0] - entity.x\n    dy = target[1] - entity.y\n    direction = vec_normalize((dx, dy))\n    print(f\"[AI] {entity.name} dir = {direction}\")  # BAD\n    return (direction[0] * entity.speed, direction[1] * entity.speed)\n\n\n# -------------------------------------------------\n#  PHYSICS ENGINE (inefficient)\n# -------------------------------------------------\ndef physics_step(entities: List[Entity], dt: float = 0.016):\n    for e in entities:\n        # Random jitter (artificial slow)\n        jitter = random.random() * 0.1\n        e.x += jitter + e.speed * dt\n        e.y += jitter + e.speed * dt\n        print(\"[PHYSICS] Updating\", e.name, \"pos =\", e.pos())  # BAD\n\n\n# -------------------------------------------------\n#  COLLISION CHECK (very slow O(n\u00b2))\n# -------------------------------------------------\ndef detect_collisions(entities: List[Entity]):\n    n = len(entities)\n    for i in range(n):\n        for j in range(i + 1, n):\n            dx = entities[i].x - entities[j].x\n            dy = entities[i].y - entities[j].y\n            d = math.sqrt(dx * dx + dy * dy)  # repeated\n            if d < 1.0:\n                print(\n                    f\"[COLLISION] {entities[i].name} hit {entities[j].name} (d={d:.3f})\"\n                )  # BAD\n                entities[i].hp -= 1\n                entities[j].hp -= 1\n\n\n# -------------------------------------------------\n#  RENDER LOOP (simulation only)\n# -------------------------------------------------\ndef render_frame(entities: List[Entity]):\n    for e in entities:\n        print(f\"[RENDER] {e.name} at {e.pos()} HP={e.hp}\")  # BAD\n\n\n# -------------------------------------------------\n#  MAIN GAMEPLAY LOOP\n# -------------------------------------------------\ndef run_battle_simulation(num_entities=20, frames=100):\n    entities = [\n        Entity(f\"Enemy_{i}\", random.random() * 10, random.random() * 10)\n        for i in range(num_entities)\n    ]\n\n    target = (15.0, 15.0)\n\n    start = time.time()\n\n    for frame in range(frames):\n        print(\"\\n===== Frame\", frame, \"=====\")\n\n        # AI steering\n        for e in entities:\n            vx, vy = compute_steering(e, target)\n            e.x += vx * 0.016\n            e.y += vy * 0.016\n\n        # Physics\n        physics_step(entities)\n\n        # Collision detection\n        detect_collisions(entities)\n\n        # Rendering\n        render_frame(entities)\n\n        time.sleep(0.01)  # artificially lower FPS\n\n        # Remove dead entities\n        entities = [e for e in entities if e.hp > 0]\n\n        if not entities:\n            print(\"[GAME] All enemies defeated!\")\n            break\n\n    total_time = time.time() - start\n    fps = frames / max(total_time, 1e-3)\n\n    return fps\n\n\ndef main():\n    logging.info(\"Starting AI Battle Simulator...\")\n    fps = run_battle_simulation()\n    logging.info(f\"Final FPS = {fps:.2f}\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T05:19:57.995Z", "_received_at": 1765343998.0019011}
