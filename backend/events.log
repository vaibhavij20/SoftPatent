{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/sustainability_grid_optimizer.py", "text": "import math\nimport random\nimport time\nimport logging\nimport statistics  # <- intentionally unused to trigger analyzer\n\n\"\"\"\nSustainability Grid Optimizer (Baseline / Inefficient Version)\n\nSimulates:\n- Regional electricity demand (per minute)\n- Solar and wind generation\n- Battery charge/discharge schedule (very naive)\n- Per-minute balancing of demand vs supply\n\nProblems (on purpose):\n- Long functions\n- print() inside hot loops\n- Repeated expensive computations\n- No batching or vectorization\n- Mixed responsibilities (simulation + optimization + logging)\n\"\"\"\n\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s [%(levelname)s] %(message)s\")\n\n\ndef simulate_region_load(region_id: int, minutes: int):\n    \"\"\"\n    Simulate per-minute demand for a given region.\n\n    Intentionally inefficient:\n    - uses time.sleep for \"fake\" delay\n    - calls math.sqrt repeatedly inside loop\n    - uses print() in loop\n    \"\"\"\n    loads = []\n    base = 50 + region_id * 5\n    for minute in range(minutes):\n        # fake CPU-heavy noise\n        noise = 0.0\n        for _ in range(20):\n            noise += math.sqrt(random.random() * (minute + 1))\n\n        demand = base + (10 * math.sin(minute / 10.0)) + noise * 0.01\n        if minute % 30 == 0:\n            print(f\"[DEBUG] Region {region_id} minute {minute} demand ~ {demand:.2f}\")  # problematic\n\n        # random peak events\n        if random.random() < 0.02:\n            demand *= 1.5\n            print(f\"[PEAK] Region {region_id} sudden spike at minute {minute}: {demand:.2f}\")\n\n        loads.append(max(demand, 0.0))\n        time.sleep(0.0005)  # tiny sleep to simulate slow loop\n\n    return loads\n\n\ndef compute_solar_output(cloud_cover_series, panel_count, base_kw_per_panel=0.3):\n    \"\"\"\n    Compute solar output per minute from cloud cover (0\u20131).\n    Intentionally redundant math and prints.\n    \"\"\"\n    output = []\n    for i, cloud in enumerate(cloud_cover_series):\n        # repeated expensive exp call\n        attenuation = math.exp(-2.0 * cloud)\n        kw = base_kw_per_panel * panel_count * attenuation\n        if i % 45 == 0:\n            print(f\"[SOLAR] t={i} cloud={cloud:.2f}, kw={kw:.2f}\")\n        output.append(max(kw, 0.0))\n    return output\n\n\ndef compute_wind_output(wind_speed_series):\n    \"\"\"\n    Compute wind output (very rough).\n    Intentionally does unnecessary branches and list appends.\n    \"\"\"\n    result = []\n    for i, v in enumerate(wind_speed_series):\n        if v < 2.0:\n            power = 0.0\n        elif v < 10.0:\n            power = (v ** 3) * 0.02\n        else:\n            power = (10.0 ** 3) * 0.02  # clipping\n\n        if i % 60 == 0:\n            print(f\"[WIND] t={i} v={v:.2f} -> {power:.2f}\")\n\n        if power < 0:\n            power = 0.0  # dead code path but kept for complexity\n        result.append(power)\n    return result\n\n\ndef optimize_battery_schedule(load_series, renewable_series, battery_capacity_kwh: float):\n    \"\"\"\n    Naive, inefficient battery schedule:\n    - single long function with too many responsibilities\n    - uses lists for everything\n    - prints in the main loop\n    \"\"\"\n    schedule = []\n    soc = 0.5 * battery_capacity_kwh  # start at 50%\n    max_charge_rate = 0.1 * battery_capacity_kwh\n    max_discharge_rate = 0.1 * battery_capacity_kwh\n\n    for minute, (load, ren) in enumerate(zip(load_series, renewable_series)):\n        net = ren - load  # positive = surplus\n        action = 0.0  # +charge, -discharge\n\n        if net > 0:\n            # surplus: try to charge\n            possible = min(net, max_charge_rate)\n            if soc + possible > battery_capacity_kwh:\n                possible = battery_capacity_kwh - soc\n            action = possible\n            soc += possible\n        else:\n            # deficit: try to discharge\n            deficit = -net\n            possible = min(deficit, max_discharge_rate, soc)\n            action = -possible\n            soc -= possible\n\n        # over-logging inside hot loop\n        if minute % 15 == 0:\n            print(\n                f\"[BATTERY] t={minute} \"\n                f\"load={load:.1f} ren={ren:.1f} net={net:.1f} \"\n                f\"action={action:.2f} soc={soc:.2f}\"\n            )\n\n        schedule.append(action)\n\n    return schedule, soc\n\n\ndef main():\n    random.seed(42)\n    minutes = 180  # 3 hours\n\n    # Simulate 3 regions\n    all_loads = []\n    for region_id in range(3):\n        loads = simulate_region_load(region_id, minutes)\n        all_loads.append(loads)\n\n    # Aggregate demand\n    agg_load = []\n    for i in range(minutes):\n        total = 0.0\n        for region_id in range(3):\n            total += all_loads[region_id][i]\n        agg_load.append(total)\n\n    # Generate simple synthetic weather\n    cloud_cover = []\n    wind_speed = []\n    for t in range(minutes):\n        cloud = 0.5 + 0.4 * math.sin(t / 25.0) + random.uniform(-0.1, 0.1)\n        w = 5.0 + 2.0 * math.sin(t / 30.0) + random.uniform(-1.0, 1.0)\n        cloud_cover.append(min(max(cloud, 0.0), 1.0))\n        wind_speed.append(max(w, 0.0))\n\n    solar = compute_solar_output(cloud_cover, panel_count=5000)\n    wind = compute_wind_output(wind_speed)\n\n    renewable_series = []\n    for i in range(minutes):\n        renewable_series.append(solar[i] + wind[i])\n\n    battery_capacity = 2000.0  # kWh\n    schedule, final_soc = optimize_battery_schedule(agg_load, renewable_series, battery_capacity)\n\n    total_demand = sum(agg_load)\n    total_ren = sum(renewable_series)\n    net_balance = total_ren + sum(schedule) - total_demand\n\n    print(\"==== Sustainability Grid Optimizer (Baseline) ====\")\n    print(f\"Minutes simulated: {minutes}\")\n    print(f\"Total demand: {total_demand:.2f} kWh-equivalent\")\n    print(f\"Total renewable: {total_ren:.2f} kWh-equivalent\")\n    print(f\"Final battery SoC: {final_soc:.2f} kWh\")\n    print(f\"Net energy balance: {net_balance:.2f} (positive = surplus)\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T04:59:26.019Z", "_received_at": 1765342766.0343602}
