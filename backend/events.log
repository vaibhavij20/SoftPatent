n    t_feed.start()\n    t_risk.start()\n\n    # Strategy loop (inefficient polling)\n    while running_flag[\"run\"] or q:\n        if q:\n            price = q.popleft()\n            strategy.update(price)\n        else:\n            time.sleep(0.001)\n\n    t_feed.join()\n    t_risk.join()\n\n    print(\"FINAL PnL:\", strategy.pnl)\n    print(\"POSITION:\", strategy.position)\n\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T01:18:45.699Z", "_received_at": 1765329525.726945}
