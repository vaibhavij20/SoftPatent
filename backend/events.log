eed / num_particles, \n        \"fps\": fps\n    }\n\ndef main():\n    return run_physics_sim(120)\n\nif __name__ == \"__main__\":\n    print(main())\n", "timestamp": "2025-12-10T04:43:01.926Z", "_received_at": 1765341781.930526}
{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/gaming_physics_engine.py", "text": "import time\nimport random\nimport math\n\n# --------------------------------------------\n#   Inefficient Gaming Physics Engine (v1)\n#   Domain: Gaming\n#   Workload: particle physics + collision loops\n# --------------------------------------------\n\nclass Particle:\n    def __init__(self, x, y, vx, vy, mass):\n        self.x = x\n        self.y = y\n        self.vx = vx\n        self.vy = vy\n        self.mass = mass\n\ndef slow_collision_check(p1, p2):\n    \"\"\"Very slow O(n^2) collision detection\"\"\"\n    # Inefficient repeated calculations\n    dx = p1.x - p2.x\n    dy = p1.y - p2.y\n    dist = math.sqrt(dx*dx + dy*dy)\n\n    if dist < 1.0:\n        # Inefficient print inside physics loop\n        print(\"Collision detected!\")  \n        # naive bounce\n        p1.vx, p2.vx = p2.vx, p1.vx\n        p1.vy, p2.vy = p2.vy, p1.vy\n\ndef update_particle(p):\n    \"\"\"Slow physics update\"\"\"\n    # repeated sqrt calls\n    speed = math.sqrt(p.vx * p.vx + p.vy * p.vy)\n\n    # pointless sleep \u2192 terrible for FPS\n    time.sleep(0.001)\n\n    # gravity\n    p.vy -= 0.1  \n\n    p.x += p.vx\n    p.y += p.vy\n\n    return speed\n\ndef run_physics_sim(num_particles=120):\n    particles = [\n        Particle(\n            random.uniform(0, 100),\n            random.uniform(0, 100),\n            random.uniform(-1, 1),\n            random.uniform(-1, 1),\n            random.uniform(0.5, 2.0)\n        )\n        for _ in range(num_particles)\n    ]\n\n    total_speed = 0\n    for i in range(num_particles):\n        for j in range(i + 1, num_particles):\n            slow_collision_check(particles[i], particles[j])\n\n        total_speed += update_particle(particles[i])\n\n    # FPS calculated inefficiently\n    fps = 60 - random.uniform(0, 15)\n    print(\"Sim FPS:\", fps)\n\n    return {\n        \"particles\": num_particles,\n        \"avg_speed\": total_speed / num_particles, \n        \"fps\": fps\n    }\n\ndef main():\n    return run_physics_sim(120)\n\nif __name__ == \"__main__\":\n    print(main())\n", "timestamp": "2025-12-10T04:43:01.928Z", "_received_at": 1765341781.931781}
