{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/complex_pipeline.py", "text": "import time\nimport math\nimport random\nimport statistics\n\n\ndef load_data(size=5000):\n    \"\"\"Inefficient data loader with repeated random calls.\"\"\"\n    print(\"Loading data...\")\n    data = []\n    for _ in range(size):\n        # Slow: calling random.random() multiple times\n        a = random.random()\n        b = random.random()\n        c = random.random()\n        data.append(a * b * c * 1000)\n    print(\"Loaded\", len(data), \"items\")\n    return data\n\n\ndef normalize_values(values):\n    \"\"\"Inefficient normalization using repeated min/max calls.\"\"\"\n    print(\"Normalizing values...\")\n    normalized = []\n    for v in values:\n        # Bad: recomputing min/max every iteration\n        mn = min(values)\n        mx = max(values)\n        normalized.append((v - mn) / (mx - mn + 1e-9))\n    print(\"Normalization complete\")\n    return normalized\n\n\ndef compute_statistics(values):\n    \"\"\"Slow statistics function.\"\"\"\n    print(\"Computing statistics...\")\n    time.sleep(1)  # Simulated delay\n    avg = sum(values) / len(values)\n    var = sum((v - avg) ** 2 for v in values) / len(values)\n    std = math.sqrt(var)\n\n    print(\"mean:\", avg, \"var:\", var, \"std:\", std)\n    return {\"mean\": avg, \"var\": var, \"std\": std}\n\n\ndef heavy_processing(values):\n    \"\"\"Frame-by-frame simulation with prints (very slow).\"\"\"\n    print(\"Starting heavy processing...\")\n    results = []\n    for i, v in enumerate(values[:300]):\n        # Bad print inside loop\n        print(\"Processing index:\", i)\n\n        # Simulated expensive computation\n        time.sleep(0.005)\n        results.append(math.sin(v) + math.sqrt(abs(v)))\n\n    print(\"Heavy processing complete\")\n    return results\n\n\ndef pipeline():\n    \"\"\"Full pipeline orchestrator.\"\"\"\n    print(\"Pipeline started\")\n    data = load_data()\n    normalized = normalize_values(data)\n    stats = compute_statistics(normalized)\n    results = heavy_processing(normalized)\n    print(\"Pipeline finished\", stats)\n    return results\n\n\nif __name__ == \"__main__\":\n    pipeline()\n", "timestamp": "2025-12-10T00:19:53.022Z", "_received_at": 1765325993.028141}
