n\n\n# -------------------------------------------------\n#  BATTLE SIMULATION LOOP\n# -------------------------------------------------\ndef simulate_battle(team_a: List[Agent], team_b: List[Agent], max_steps=200):\n    \"\"\"Main optimized battle loop.\"\"\"\n    precomputed_batch = batch_damage_calc(1.0, 200)  # reused randomness\n    batch_idx = 0\n\n    for step in range(max_steps):\n        # FRAME PACING (no heavy print)\n        if step % 10 == 0:\n            logger.debug(\"Sim step %d\", step)\n\n        # Team A \u2192 Team B attacks\n        for a in team_a:\n            if not a.is_alive():\n                continue\n\n            target = choose_target(a, team_b)\n            if target:\n                noise = precomputed_batch[batch_idx]\n                batch_idx = (batch_idx + 1) % len(precomputed_batch)\n                target.hp -= max(0, a.attack + noise)\n\n        # Team B \u2192 Team A attacks\n        for b in team_b:\n            if not b.is_alive():\n                continue\n\n            target = choose_target(b, team_a)\n            if target:\n                noise = precomputed_batch[batch_idx]\n                batch_idx = (batch_idx + 1) % len(precomputed_batch)\n                target.hp -= max(0, b.attack + noise)\n\n        # End conditions\n        alive_a = any(a.is_alive() for a in team_a)\n        alive_b = any(b.is_alive() for b in team_b)\n\n        if not alive_a or not alive_b:\n            break\n\n    return {\n        \"team_a_alive\": sum(1 for a in team_a if a.is_alive()),\n        \"team_b_alive\": sum(1 for b in team_b if b.is_alive()),\n        \"steps_executed\": step + 1\n    }\n\n\n# -------------------------------------------------\n#  MAIN WRAPPER\n# -------------------------------------------------\ndef main():\n    logger.info(\"Starting optimized AI battle simulation...\")\n\n    # Create agents\n    team_a = [Agent(random.uniform(0, 5), random.uniform(0, 5), 100, 8) for _ in range(10)]\n    team_b = [Agent(random.uniform(5, 10), random.uniform(5, 10), 100, 7) for _ in range(10)]\n\n    result = simulate_battle(team_a, team_b)\n    logger.info(\"Battle Summary: %s\", result)\n\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T05:24:21.218Z", "_received_at": 1765344261.223973}
