{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/speech_therapy_pipeline.py", "text": "import numpy as np\nimport logging\n\nlogging.basicConfig(level=logging.INFO)\n\ndef compute_mfcc(frame):\n    # Vectorized MFCC simulation\n    noise = np.random.uniform(-0.5, 0.5, size=40)\n    base = np.mean(frame)\n    mfcc = base + noise\n    return mfcc.tolist()\n\ndef score_pronunciation(mfcc):\n    # Vectorized scoring\n    arr = np.array(mfcc)\n    return float(np.mean(np.abs(np.sin(arr))))\n\ndef process_audio_stream(frames):\n    results = []\n    for idx, frame in enumerate(frames):\n        logging.info(\"Processing frame %d\", idx)\n        mfcc = compute_mfcc(frame)\n        score = score_pronunciation(mfcc)\n        results.append(score)\n    return results\n\ndef main():\n    frames = [np.random.rand(512) for _ in range(50)]\n    logging.info(\"Speech therapy pipeline started\")\n    out = process_audio_stream(frames)\n    logging.info(\"Final scores sample: %s\", out[:5])\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T04:49:10.780Z", "_received_at": 1765342150.785984}
{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/speech_therapy_pipeline.py", "text": "import numpy as np\nimport logging\n\nlogging.basicConfig(level=logging.INFO)\n\ndef compute_mfcc(frame):\n    # Vectorized MFCC simulation\n    noise = np.random.uniform(-0.5, 0.5, size=40)\n    base = np.mean(frame)\n    mfcc = base + noise\n    return mfcc.tolist()\n\ndef score_pronunciation(mfcc):\n    # Vectorized scoring\n    arr = np.array(mfcc)\n    return float(np.mean(np.abs(np.sin(arr))))\n\ndef process_audio_stream(frames):\n    results = []\n    for idx, frame in enumerate(frames):\n        logging.info(\"Processing frame %d\", idx)\n        mfcc = compute_mfcc(frame)\n        score = score_pronunciation(mfcc)\n        results.append(score)\n    return results\n\ndef main():\n    frames = [np.random.rand(512) for _ in range(50)]\n    logging.info(\"Speech therapy pipeline started\")\n    out = process_audio_stream(frames)\n    logging.info(\"Final scores sample: %s\", out[:5])\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T04:49:10.782Z", "_received_at": 1765342150.78724}
