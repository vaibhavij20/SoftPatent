\n            # deficit: try to discharge\n            deficit = -net\n            possible = min(deficit, max_discharge_rate, soc)\n            action = -possible\n            soc -= possible\n\n        # over-logging inside hot loop\n        if minute % 15 == 0:\n            print(\n                f\"[BATTERY] t={minute} \"\n                f\"load={load:.1f} ren={ren:.1f} net={net:.1f} \"\n                f\"action={action:.2f} soc={soc:.2f}\"\n            )\n\n        schedule.append(action)\n\n    return schedule, soc\n\n\ndef main():\n    random.seed(42)\n    minutes = 180  # 3 hours\n\n    # Simulate 3 regions\n    all_loads = []\n    for region_id in range(3):\n        loads = simulate_region_load(region_id, minutes)\n        all_loads.append(loads)\n\n    # Aggregate demand\n    agg_load = []\n    for i in range(minutes):\n        total = 0.0\n        for region_id in range(3):\n            total += all_loads[region_id][i]\n        agg_load.append(total)\n\n    # Generate simple synthetic weather\n    cloud_cover = []\n    wind_speed = []\n    for t in range(minutes):\n        cloud = 0.5 + 0.4 * math.sin(t / 25.0) + random.uniform(-0.1, 0.1)\n        w = 5.0 + 2.0 * math.sin(t / 30.0) + random.uniform(-1.0, 1.0)\n        cloud_cover.append(min(max(cloud, 0.0), 1.0))\n        wind_speed.append(max(w, 0.0))\n\n    solar = compute_solar_output(cloud_cover, panel_count=5000)\n    wind = compute_wind_output(wind_speed)\n\n    renewable_series = []\n    for i in range(minutes):\n        renewable_series.append(solar[i] + wind[i])\n\n    battery_capacity = 2000.0  # kWh\n    schedule, final_soc = optimize_battery_schedule(agg_load, renewable_series, battery_capacity)\n\n    total_demand = sum(agg_load)\n    total_ren = sum(renewable_series)\n    net_balance = total_ren + sum(schedule) - total_demand\n\n    print(\"==== Sustainability Grid Optimizer (Baseline) ====\")\n    print(f\"Minutes simulated: {minutes}\")\n    print(f\"Total demand: {total_demand:.2f} kWh-equivalent\")\n    print(f\"Total renewable: {total_ren:.2f} kWh-equivalent\")\n    print(f\"Final battery SoC: {final_soc:.2f} kWh\")\n    print(f\"Net energy balance: {net_balance:.2f} (positive = surplus)\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T04:59:27.373Z", "_received_at": 1765342767.3813}
