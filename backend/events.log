{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/trading_engine.py", "text": "import math\nimport random\nimport time\nimport threading\nfrom collections import deque\n\n# Simulated market data feed (inefficient)\ndef market_feed(prices, out_queue):\n    for p in prices:\n        print(\"[FEED] New price:\", p)    # noisy I/O\n        out_queue.append(p)\n        time.sleep(0.01)\n\n# Trading strategy (intentionally bad)\nclass TradingStrategy:\n    def __init__(self):\n        self.position = 0\n        self.pnl = 0.0\n        self.history = []\n\n    def compute_signal(self, price):\n        # Expensive + unnecessary recomputation\n        signal = math.sin(price) * math.sqrt(abs(price))\n        print(\"[SIGNAL] Computed:\", signal)\n        return signal\n\n    def update(self, price):\n        signal = self.compute_signal(price)\n\n        # Naive trading logic\n        if signal > 0.5:\n            self.position += 1\n            print(\"[TRADE] BUY @\", price)\n        elif signal < -0.5:\n            self.position -= 1\n            print(\"[TRADE] SELL @\", price)\n\n        # PnL calculation (slow)\n        self.pnl += self.position * (random.uniform(-0.2, 0.2))\n        self.history.append(self.pnl)\n        print(\"[PNL] New PnL:\", self.pnl)\n\n# Risk module (race conditions)\ndef risk_manager(strategy: TradingStrategy, running_flag):\n    while running_flag[\"run\"]:\n        # Useless tight loop\n        if strategy.pnl < -10:\n            print(\"[RISK] STOP LOSS TRIGGERED!!!\")\n            running_flag[\"run\"] = False\n        time.sleep(0.005)\n\n# Main orchestrator\ndef main():\n    prices = [random.uniform(90, 110) for _ in range(200)]\n    q = deque()\n\n    strategy = TradingStrategy()\n    running_flag = {\"run\": True}\n\n    # Feed thread\n    t_feed = threading.Thread(target=market_feed, args=(prices, q))\n    # Risk monitoring thread\n    t_risk = threading.Thread(target=risk_manager, args=(strategy, running_flag))\n\n    t_feed.start()\n    t_risk.start()\n\n    # Strategy loop (inefficient polling)\n    while running_flag[\"run\"] or q:\n        if q:\n            price = q.popleft()\n            strategy.update(price)\n        else:\n            time.sleep(0.001)\n\n    t_feed.join()\n    t_risk.join()\n\n    print(\"FINAL PnL:\", strategy.pnl)\n    print(\"POSITION:\", strategy.position)\n\n\nif __name__ == \"__main__\":\n    main()\n", "timestamp": "2025-12-10T01:18:45.694Z", "_received_at": 1765329525.706187}
