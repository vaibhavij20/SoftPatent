{"type": "edit", "uri": "file:///Users/vaibhavijaiswal/Desktop/python/satellite_processing_system.py", "text": "import math\nimport random\nimport time\nimport numpy as np\n\n# Simulate receiving multi-spectral satellite frames\ndef load_satellite_frame():\n    frame = {\n        \"red\":    [random.randint(0, 255) for _ in range(5000)],\n        \"green\":  [random.randint(0, 255) for _ in range(5000)],\n        \"blue\":   [random.randint(0, 255) for _ in range(5000)],\n        \"thermal\":[random.uniform(15.0, 45.0) for _ in range(5000)],\n    }\n    return frame\n\n# Very slow NDVI-style calculation\ndef compute_ndvi(frame):\n    red = frame[\"red\"]\n    nir = frame[\"thermal\"]  # pretend thermal = NIR\n\n    ndvi = []\n    for r, n in zip(red, nir):\n        val = (n - r) / (n + r + 0.00001)\n        ndvi.append(val)\n\n    print(\"NDVI computed\u2026 sample:\", ndvi[:3])\n    return ndvi\n\n# Orbit drift predictor (simplified)\ndef orbit_drift_predictor(prev_pos, velocity):\n    drift = []\n    for i in range(10000):\n        noisy = velocity + random.uniform(-0.001, 0.001)\n        next_pos = prev_pos + noisy\n        drift.append(next_pos)\n\n        if i % 2000 == 0:\n            print(\"Orbit drift step:\", i, \"pos:\", next_pos)\n\n        prev_pos = next_pos\n    return drift\n\n# Main pipeline\ndef process_stream(frames=3):\n    print(\"Starting satellite pipeline\u2026\")\n    all_ndvi = []\n    orbit_positions = []\n\n    prev_pos = 700.0  # km altitude\n    velocity = 7.8    # km/s\n\n    for f in range(frames):\n        print(\"Processing frame\", f)\n\n        frame = load_satellite_frame()\n        ndvi = compute_ndvi(frame)\n        all_ndvi.append(sum(ndvi) / len(ndvi))\n\n        drift = orbit_drift_predictor(prev_pos, velocity)\n        orbit_positions.append(drift[-1])\n        prev_pos = drift[-1]\n\n    print(\"Pipeline complete.\")\n    print(\"Mean NDVI values:\", all_ndvi)\n    print(\"Final orbit positions:\", orbit_positions)\n    return all_ndvi, orbit_positions\n\nif __name__ == \"__main__\":\n    process_stream()\n", "timestamp": "2025-12-10T01:29:39.581Z", "_received_at": 1765330179.5921972}
