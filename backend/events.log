st = []\n    for i in range(50):\n        dx = tx - (x + i * 0.2 * math.cos(h))\n        dy = ty - (y + i * 0.2 * math.sin(h))\n        d = math.sqrt(dx * dx + dy * dy)\n        cost.append(d + random.random() * 0.05)\n        print(f\"[MPC] Step {i}: cost={cost[-1]}\")  # <-- BAD\n\n    best_idx = min(range(len(cost)), key=lambda i: cost[i])\n    v = 1.0\n    w = (best_idx - 25) * 0.01\n    return v, w\n\n\n# -------------------------------------------------\n#  BATTERY MODEL\n# -------------------------------------------------\ndef estimate_battery_drain(v, load_factor):\n    time.sleep(0.005)  # slow on purpose\n    return max(10, 100 - (v * 5 + load_factor * 2 + random.random() * 3))\n\n\n# -------------------------------------------------\n#  PATH GENERATOR (cubic-like smoothing)\n# -------------------------------------------------\ndef generate_path(target):\n    path = []\n    for i in range(50):\n        px = target[0] * (i / 50) + random.random() * 0.5\n        py = target[1] * (i / 50) + random.random() * 0.5\n        path.append((px, py))\n        print(\"[Path] Generated waypoint:\", px, py)  # <-- BAD\n    return path\n\n\n# -------------------------------------------------\n#  MAIN NAVIGATION LOOP\n# -------------------------------------------------\ndef navigation_loop():\n    ekf = EKF()\n    target = (10, 8)\n    path = generate_path(target)\n\n    for step, waypoint in enumerate(path):\n        print(\"\\n=== Navigation Step\", step, \"===\")  # <-- BAD\n\n        # LIDAR\n        lidar = simulate_lidar(tuple(ekf.state[:2]))\n\n        # EKF predict\n        v, w = mpc_optimize(ekf.state, waypoint)\n        ekf.predict(v, w, 0.1)\n\n        # EKF update\n        ekf.update(lidar)\n\n        # Battery\n        battery = estimate_battery_drain(v, load_factor=random.random())\n        print(\"[Battery]\", battery)  # <-- BAD\n\n        if battery < 15:\n            print(\"[WARNING] Low battery \u2013 slowing down!\")  # <-- BAD\n\n        time.sleep(